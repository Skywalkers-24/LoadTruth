# =============================================================================
# LoadTruth Configuration (.env)
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Meta AI Models (Vision, OCR, Transcription)
# -----------------------------------------------------------------------------
# Your Meta Model API key from dev.meta.ai.
# If left as TO_BE_UPDATED_LATER, LoadTruth runs in offline mode
# using pre-recorded disaster debris video fixtures at zero cost.
MODEL_API_KEY=TO_BE_UPDATED_LATER
MODEL_API_BASE_URL=https://api.meta.ai/v1
SAM_MODEL=sam-3.1
SPARK_MODEL=muse-spark-1.3

# Set MOCK_AI=1 to force offline fixture replay (useful for tests or local dev).
# Set MOCK_AI=0 when you want real model inference via MODEL_API_KEY.
MOCK_AI=0

# Safety spending caps in USD to prevent runaway API bills during testing.
BUILD_SPEND_CAP_USD=100
SPEND_WARN_USD=80

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL or SQLite)
# -----------------------------------------------------------------------------
# Local development default is SQLite (no external setup required):
# DATABASE_URL=sqlite+aiosqlite:///./loadtruth.db
#
# Production / Docker Compose default is PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loadtruth

# Optional Supabase integration (if using Supabase Auth or hosted Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-signing-secret

# -----------------------------------------------------------------------------
# 3. Object Storage (Backblaze B2 / S3-Compatible)
# -----------------------------------------------------------------------------
# Stores uploaded video clips and cryptographic audit evidence.
# In local development without credentials, clips are held in transient memory.
B2_KEY_ID=00540ad8c08b0a80000000001
B2_KEY_NAME=loadtruth
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=loadtruth-evidence
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_PREFIX=loadtruth/evidence
B2_SIGNED_URL_TTL_S=900

# -----------------------------------------------------------------------------
# 4. Redis Cache & Job Queue
# -----------------------------------------------------------------------------
# Used for video pipeline progress caching and background processing.
REDIS_URL=redis://localhost:6379/0
PIPELINE_RESULT_CACHE_ENABLED=false
API_CACHE_ENABLED=false

# -----------------------------------------------------------------------------
# 5. Open-Weight Model Partners (Baseten, Modal, Fireworks)
# -----------------------------------------------------------------------------
# Primary provider for Muse Spark reasoning: "meta", "baseten", "modal", or "fireworks"
SPARK_PROVIDER=meta

# Comma-separated list of fallback providers if the primary provider times out
SPARK_FALLBACK_PROVIDERS=baseten,modal

# Baseten (Open weights inference)
BASETEN_API_KEY=b10_your_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_INPUT_PRICE=1.25
BASETEN_CACHED_INPUT_PRICE=0.15
BASETEN_OUTPUT_PRICE=4.25

# Modal (Serverless open weights endpoint)
MODAL_PROXY_TOKEN_ID=wk-your-token-id
MODAL_PROXY_TOKEN_SECRET=ws-your-token-secret
MODAL_BASE_URL=https://your-workspace--muse-spark-server.modal.direct/v1
MODAL_MODEL=meta-models/Muse-Spark-Open-816B-A42B
MODAL_ROUTING_AFFINITY_KEY=
MODAL_INPUT_PRICE=1.25
MODAL_CACHED_INPUT_PRICE=0.15
MODAL_OUTPUT_PRICE=4.25

# Fireworks AI (Open weights endpoint)
FIREWORKS_API_KEY=fw_your_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open
FIREWORKS_SUPPORTS_VISION=false
FIREWORKS_INPUT_PRICE=0.0
FIREWORKS_CACHED_INPUT_PRICE=0.0
FIREWORKS_OUTPUT_PRICE=0.0

# -----------------------------------------------------------------------------
# 6. Admin Portal & Authentication
# -----------------------------------------------------------------------------
# Credentials for logging into the admin portal (/superadmin)
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=LoadTruthAdmin2026!

# Optional pre-computed SHA-256 hashes of username and password for zero-plaintext deployments
SUPERADMIN_USERNAME_HASH=
SUPERADMIN_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# 7. Video Processing & Frame Sampling
# -----------------------------------------------------------------------------
# Sampling rate: frames extracted per second from video before sending to models.
FRAME_SAMPLE_FPS=3.0

# Maximum number of keyframes analyzed per haul video (60 frames = 20 sec at 3 fps).
TARGET_SAMPLED_FRAMES=60
MAX_SAMPLED_FRAMES=60

# Max concepts SAM segments in parallel (truck bed, load crest, tailgate, etc.).
SAM_LOAD_MAX_CONCEPTS=6
SAM_PARSE_WORKERS=1

# Upload size limits for video files (in bytes)
DEMO_UPLOAD_MAX_BYTES=104857600   # 100 MB
ANALYSIS_MAX_BYTES=52428800       # 50 MB

# -----------------------------------------------------------------------------
# 8. Web App & Frontend (Next.js)
# -----------------------------------------------------------------------------
# Web application mode: "default" for normal dashboard, or "judge" for hackathon review mode.
NEXT_PUBLIC_APP_MODE=default

# Optional: pin a specific ticket ID when opening in judge mode. Leave blank to auto-select.
NEXT_PUBLIC_JUDGE_TICKET_ID=

# Browser-side video upload size limits and compression triggers
NEXT_PUBLIC_MAX_UPLOAD_SECONDS=30
NEXT_PUBLIC_MAX_UPLOAD_MB=50
NEXT_PUBLIC_COMPRESS_ABOVE_MB=10
NEXT_PUBLIC_MAX_COMPRESSED_MB=5
NEXT_PUBLIC_ENABLE_CLIENT_COMPRESSION=true

# -----------------------------------------------------------------------------
# 9. Server Environment & Logging
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_API_LOG_PATH=logs/meta_api.jsonl
