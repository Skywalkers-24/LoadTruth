# LoadTruth environment — copy to .env and fill in. .env is gitignored.

# --- Meta Model API ---
# A real key (dev.meta.ai) switches the pipeline to live SAM 3.1 + Muse Spark.
# Check it with `make live-check` (or scripts/live-check.sh [clip]).
MODEL_API_KEY=TO_BE_UPDATED_LATER

# --- Supabase / Postgres ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loadtruth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# HS256 signing secret for verifying Supabase access tokens on the API.
SUPABASE_JWT_SECRET=

# --- SuperAdmin / Developer Credentials (login at /superadmin) ---
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=LoadTruthAdmin!

# --- Redis (background worker) ---
REDIS_URL=redis://localhost:6379/0

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- AI cost controls (PLAN.md §5a / §5b) ---
# 1 = replay recorded fixtures even when a key is set (zero credits).
MOCK_AI=0
# Pause new BUILD pipeline runs at this spend; reserve the rest for judging.
BUILD_SPEND_CAP_USD=100
SPEND_WARN_USD=80

# --- Frontend app mode (build-time, baked into the bundle) ---
# "judge" opens the console on a pinned, pre-cached ticket (the headline
# over-call) with a "Run live" action; anything else is the normal console.
NEXT_PUBLIC_APP_MODE=default
# Optional: pin judge mode to a specific ticket id. Leave blank to let the
# console pick the highest flagged dollar-delta ticket automatically.
NEXT_PUBLIC_JUDGE_TICKET_ID=

# Backblaze B2 is required. There is no local storage fallback.
# Keep real values in .env or deployment secrets.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_KEY_NAME=
# Copy the bucket S3 endpoint and region from Backblaze.
B2_S3_ENDPOINT=
B2_REGION=

B2_KEY_PREFIX=loadtruth/evidence

# Partner model routes. SAM segmentation always uses Meta.
# Chat/vision task defaults; individual tasks can be changed in AI & Models.
SPARK_PROVIDER=meta
# Optional ordered failover on transient/network/invalid-response failures.
# Credentials and vision capability must be configured for every fallback.
SPARK_FALLBACK_PROVIDERS=

# Video frame policy. Defaults preserve the existing cost-controlled 60-frame
# sampling. For native temporal coverage, set PRESERVE_SOURCE_FRAMES=true and
# MAX_SAMPLED_FRAMES=0; this keeps all source frames and raises SAM usage.
TARGET_SAMPLED_FRAMES=60
MAX_SAMPLED_FRAMES=60
PRESERVE_SOURCE_FRAMES=false

BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_INPUT_PRICE=1.25
BASETEN_CACHED_INPUT_PRICE=0.15
BASETEN_OUTPUT_PRICE=4.25
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Use your endpoint URL; credentials remain server-side.
MODAL_BASE_URL=
MODAL_MODEL=meta-models/Muse-Spark-Open-816B-A42B
MODAL_ROUTING_AFFINITY_KEY=
MODAL_INPUT_PRICE=1.25
MODAL_CACHED_INPUT_PRICE=0.15
MODAL_OUTPUT_PRICE=4.25
# Fireworks remains disabled until a key and exact model/deployment are supplied.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=
FIREWORKS_SUPPORTS_VISION=false
FIREWORKS_INPUT_PRICE=0
FIREWORKS_CACHED_INPUT_PRICE=0
FIREWORKS_OUTPUT_PRICE=0

# Limits for the free Render instance (bytes).
DEMO_UPLOAD_MAX_BYTES=104857600
ANALYSIS_MAX_BYTES=20971520
B2_SIGNED_URL_TTL_S=900

# Keep full mask/result objects out of the small Render RAM/Redis cache.
PIPELINE_RESULT_CACHE_ENABLED=false
