# =============================================================================
# LoadTruth Configuration (.env)
# =============================================================================

# =============================================================================
# PART 1: REQUIRED FOR LOCAL SETUP (Core Services, Database & AI Mode)
# Minimal configuration needed to boot and run the complete stack locally.
# =============================================================================

# --- Database & Cache ---
# Database connection: PostgreSQL for Docker Compose (or SQLite for native local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loadtruth
# SQLite alternative (uncomment for zero-dependency native run):
# DATABASE_URL=sqlite+aiosqlite:///./loadtruth.db

# Redis connection URL for background jobs, locks, and pipeline caching
REDIS_URL=redis://localhost:6379/0

# --- AI Perception Engine (Meta Model API) ---
# Meta Model API key; leave as placeholder to use free local offline fixtures
MODEL_API_KEY=YOUR_META_API_KEY

# Base URL for the official Meta Model API
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Segment Anything Model version used for truck bed and debris contour segmentation
SAM_MODEL=sam-3.1

# Multimodal reasoning model used for placard OCR and FEMA material classification
SPARK_MODEL=muse-spark-1.3

# --- SuperAdmin / Developer Credentials ---
# Login username for the operator and review admin console (/superadmin)
SUPERADMIN_USERNAME=admin

# Login password for the operator and review admin console (/superadmin)
SUPERADMIN_PASSWORD=LoadTruthAdmin2026!

# --- Server & Web Frontend ---
# Application environment mode (development or production)
ENVIRONMENT=development

# Allowed cross-origin browser origins for the FastAPI backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js UI mode: "default" for full dashboard, or "judge" for focused hackathon review
NEXT_PUBLIC_APP_MODE=default


# =============================================================================
# PART 2: OPTIONAL & ADVANCED SETTINGS (Cloud Storage, Fallbacks & Tuning)
# Optional enhancements for production, cloud integrations, and fine-tuning.
# =============================================================================

# Set to 1 for zero-cost offline fixture replay; set to 0 for live Meta API calls
MOCK_AI=1

# --- Cloud Object Storage (Backblaze B2 / S3 - Memory Fallback if Empty) ---
# Backblaze B2 Application Key ID (clips stay in local memory/disk if unset)
B2_KEY_ID=
# Backblaze B2 Application Key secret
B2_APPLICATION_KEY=
# Application key identifier name
B2_KEY_NAME=loadtruth
# Target S3/B2 bucket name for stored evidence clips
B2_BUCKET_NAME=loadtruth-evidence
# S3-compatible API endpoint URL for Backblaze B2
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# AWS / B2 region of the storage bucket
B2_REGION=us-east-005
# Folder prefix for stored evidence objects inside the bucket
B2_KEY_PREFIX=loadtruth/evidence
# Expiration lifetime in seconds for generated signed pre-signed video URLs
B2_SIGNED_URL_TTL_S=900

# --- Hosted Supabase Auth & Database (Optional) ---
# Hosted Supabase project URL (leave empty when using local database)
SUPABASE_URL=
# Supabase public anonymous API key
SUPABASE_ANON_KEY=
# Supabase service role secret key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase JWT secret (HS256) used to verify access tokens on the API
SUPABASE_JWT_SECRET=

# --- Open-Weight Model Partners (Baseten, Modal, Fireworks) ---
# Primary provider for Muse Spark reasoning ("meta", "baseten", "modal", or "fireworks")
SPARK_PROVIDER=meta
# Comma-separated list of secondary providers if the primary provider times out
SPARK_FALLBACK_PROVIDERS=baseten,modal

# Baseten API key for private open-weights inference
BASETEN_API_KEY=
# Baseten inference base URL endpoint
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Model identifier deployed on Baseten
BASETEN_MODEL=meta-models/muse-spark-open-1026
# Input token price per 1M tokens on Baseten
BASETEN_INPUT_PRICE=1.25
# Cached input token price per 1M tokens on Baseten
BASETEN_CACHED_INPUT_PRICE=0.15
# Output token price per 1M tokens on Baseten
BASETEN_OUTPUT_PRICE=4.25

# Modal proxy token ID for serverless open-weights execution
MODAL_PROXY_TOKEN_ID=
# Modal proxy token secret
MODAL_PROXY_TOKEN_SECRET=
# Modal deployed service base URL
MODAL_BASE_URL=
# Model identifier running on Modal
MODAL_MODEL=meta-models/Muse-Spark-Open-816B-A42B
# Optional routing affinity key for Modal instance stickiness
MODAL_ROUTING_AFFINITY_KEY=
# Input token price per 1M tokens on Modal
MODAL_INPUT_PRICE=1.25
# Cached input token price per 1M tokens on Modal
MODAL_CACHED_INPUT_PRICE=0.15
# Output token price per 1M tokens on Modal
MODAL_OUTPUT_PRICE=4.25

# Fireworks AI API key for open-weights endpoints
FIREWORKS_API_KEY=
# Fireworks API base URL endpoint
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Model identifier deployed on Fireworks
FIREWORKS_MODEL=
# Whether the configured Fireworks model supports image input
FIREWORKS_SUPPORTS_VISION=false
# Input token price per 1M tokens on Fireworks
FIREWORKS_INPUT_PRICE=0.0
# Cached input token price per 1M tokens on Fireworks
FIREWORKS_CACHED_INPUT_PRICE=0.0
# Output token price per 1M tokens on Fireworks
FIREWORKS_OUTPUT_PRICE=0.0

# --- Budget & Spend Caps ---
# Hard budget limit in USD to stop all live API calls and prevent runaway bills
BUILD_SPEND_CAP_USD=100
# Warning threshold in USD to notify operators of approaching budget limits
SPEND_WARN_USD=80

# --- Video Processing & Frame Sampling ---
# Frame extraction rate (frames per second sampled from video before model inference)
FRAME_SAMPLE_FPS=3.0
# Target count of keyframes analyzed per video (60 frames = 20 sec at 3 fps)
TARGET_SAMPLED_FRAMES=60
# Hard ceiling on total frames dispatched to SAM 3.1 per video
MAX_SAMPLED_FRAMES=60
# Maximum semantic prompt concepts segmented simultaneously by SAM 3.1
SAM_LOAD_MAX_CONCEPTS=6
# Worker process count for parallel SAM mask vectorization
SAM_PARSE_WORKERS=1
# Maximum allowed file upload size for demo uploads in bytes (100 MB)
DEMO_UPLOAD_MAX_BYTES=104857600
# Maximum video size processed through the perception pipeline in bytes (50 MB)
ANALYSIS_MAX_BYTES=52428800

# --- Frontend Upload Limits & Client Compression ---
# Optional ticket ID to automatically display when opening the app in judge mode
NEXT_PUBLIC_JUDGE_TICKET_ID=
# Maximum video duration in seconds accepted by the browser uploader
NEXT_PUBLIC_MAX_UPLOAD_SECONDS=30
# Maximum file size in MB accepted by the browser uploader
NEXT_PUBLIC_MAX_UPLOAD_MB=50
# File size threshold in MB that automatically triggers client-side video compression
NEXT_PUBLIC_COMPRESS_ABOVE_MB=10
# Target compressed file size in MB when client compression triggers
NEXT_PUBLIC_MAX_COMPRESSED_MB=5
# Enable in-browser FFmpeg WebAssembly video compression before network upload
NEXT_PUBLIC_ENABLE_CLIENT_COMPRESSION=true

# --- Caching, Security Hashes & Audit Logs ---
# Enable Redis caching for finished video pipeline runs
PIPELINE_RESULT_CACHE_ENABLED=false
# Enable Redis caching for read-heavy public API routes
API_CACHE_ENABLED=false
# Application logging severity level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Local file path where sanitized Meta Model API call logs are recorded
MODEL_API_LOG_PATH=logs/meta_api.jsonl
# Pre-computed SHA-256 hash of SUPERADMIN_USERNAME for zero-plaintext deployments
SUPERADMIN_USERNAME_HASH=
# Pre-computed SHA-256 hash of SUPERADMIN_PASSWORD for zero-plaintext deployments
SUPERADMIN_PASSWORD_HASH=
