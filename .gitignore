# Secrets — never commit
.env
.env.*
!.env.example

# Python
**/.venv/
**/__pycache__/
*.py[cod]
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/*.egg-info/

# Node / Next
**/node_modules/
**/.next/
**/.open-next/
**/.wrangler/
**/out/
**/coverage/
*.tsbuildinfo
**/next-env.d.ts

# OS / editor
.DS_Store
**/.DS_Store

# Large demo video exports (keep out of git; share separately)
*.mp4

# Local review/scratch artifacts
semantic-review/

# Logs / local artifacts
responses.log
# Meta API exchange log (may contain evidence details); see backend/app/ai/api_log.py
logs/
# Stored evidence clips (customer media); see backend/app/pipeline/evidence_store.py
media/
*.local

# Local scratch / experiment scripts and logs (not part of the app)
scratch/

# Generated test clips (regenerable ~1MB fixtures); keep only the README.
data_tests/*.mp4

# Benchmark clips are large customer/scale-model media; the manifest + results
# JSON are committed, the clip bytes are not (Winner.md B1/B2).
data_bench/clips/*
!data_bench/clips/.gitkeep
